pipeline {
agent any

	stages {
		stage ('install-nginx')
		{
			steps {
				sh 'sudo apt update -y'
				sh 'sudo apt install nginx -y'
			}
		}


stage ('deploy-index')
		{
			steps {
				sh 'sudo echo "Welcome to Young Minds." > index.html'
				sh 'sudo mv index.html /var/www/html/index.html'

			}
		}
}
}
